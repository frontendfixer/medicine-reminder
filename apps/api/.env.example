DATABASE_URL=postgres://med:med@localhost:5442/med
DATABASE_URL_TEST=postgres://med:med@localhost:5442/med_test

# Field encryption keys: kid:base64(32 bytes), comma separated. Generate with: openssl rand -base64 32
# Production keys come from the secret manager, never from the repo.
FIELD_ENCRYPTION_KEYS=dev1:<base64 of 32 random bytes>
FIELD_ENCRYPTION_ACTIVE_KID=dev1

# Keyed hash pepper (at least 32 bytes, base64). Production value comes from the secret manager.
HMAC_PEPPER=<base64 of 32 random bytes>

# Auth. Production values come from the secret manager. Generate each with: openssl rand -base64 32
JWT_ACCESS_SECRET=<base64 of 32 random bytes>
# Argon2 pepper. Losing it makes every password unverifiable and v1 has no reset (D-096): back it up.
PASSWORD_PEPPER=<base64 of 32 random bytes>
REDIS_URL=redis://localhost:6389/0
REDIS_URL_TEST=redis://localhost:6389/1

# Dev only: give every new account the Starter plan until RevenueCat exists (Phase 4). The server refuses to start with this set when NODE_ENV=production.
DEV_GRANT_STARTER=true
